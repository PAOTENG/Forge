# Copy this file to `.env` in the repo root. Never commit real keys.

# At least one of these is required to run the agent.
# DeepSeek is picked first when DEEPSEEK_API_KEY is set.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Zhipu GLM (open.bigmodel.cn)
ZHIPUAI_API_KEY=
ZAI_API_KEY=

# Alibaba Qwen via DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Grok / xAI. Cursor's built-in Grok has no public key; fill an xAI key here.
XAI_API_KEY=
CURSOR_API_KEY=
CURSOR_API_BASE=

# Optional override. Examples:
#   deepseek/deepseek-chat
#   deepseek/deepseek-reasoner
#   gpt-4.1
#   anthropic/claude-sonnet-4-5
FORGE_MODEL=

FORGE_API_TOKEN=

DATABASE_URL=postgresql+asyncpg://forge:forge@127.0.0.1:5432/forge
# Session sandbox: opening Investigate / New session ensures a Docker container
# (Docker Desktop must be running). Missing IMAGE is built from
# infra/sandbox/Dockerfile. NETWORK=none means the container has no network.
# Process cap 256 is hardcoded in backend/app/services/sandbox.py.
FORGE_SANDBOX_IMAGE=forge-runner:latest
FORGE_SANDBOX_MEMORY=2g
FORGE_SANDBOX_NETWORK=none
FORGE_API_HOST=127.0.0.1
FORGE_API_PORT=8787

# Duty console (phone H5 + WeCom / DingTalk entry)
# Phones should open Vite, not the raw API port.
# Example: http://192.168.1.12:5173
FORGE_PUBLIC_URL=http://127.0.0.1:5173
FORGE_DUTY_TOKEN=
# Empty = this Forge repo. Set to the product repo on the duty PC.
FORGE_DUTY_WORKSPACE=
FORGE_DUTY_NOTIFY_USER=@all

# WeCom application (textcard). Not a mini-program.
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=

# DingTalk custom robot (actionCard). Optional HMAC secret.
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# Optional generic JSON webhook: {title, text, url, source}
DUTY_WEBHOOK_URL=

# Monitored business app (order-api). Empty cwd = targets/order-api
FORGE_TARGET_NAME=order-api
FORGE_TARGET_CWD=
FORGE_TARGET_HEALTH=http://127.0.0.1:8790/health
FORGE_TARGET_CANARY=http://127.0.0.1:8790/canary
FORGE_TARGET_AUTOSTART=true
FORGE_WATCHDOG=true
FORGE_WATCHDOG_COOLDOWN=120

# Admin HITL bypass. Default false: engineers still approve writes/tests/git/restart.
# When true, role=admin skips mutating-tool approval. The eval runner does not
# need this; it sets ForgeContext.auto_approve per session.
FORGE_ADMIN_AUTO_APPROVE=false

# First browser visit creates the admin account. Optional machine token still
# works as admin if set.
# FORGE_API_TOKEN=
